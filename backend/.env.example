# Backend Environment Variables
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/seouldata
SUPABASE_URL=
SUPABASE_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development

# Gemini 생성 문장은 선택적으로 활성화한다. 키가 없으면 항상 결정론적 인사이트를 사용한다.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# 인사이트 전용 endpoint의 외부 생성 제한 시간이다. 기존 overview 응답과 분리해 적용한다.
GEMINI_TIMEOUT_SECONDS=6.0
# 프로세스 내부 제공자 보호 설정이며 결과 캐시는 사용하지 않는다.
GEMINI_MAX_RETRIES=2
GEMINI_MAX_CONCURRENT_REQUESTS=2
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=0.1
